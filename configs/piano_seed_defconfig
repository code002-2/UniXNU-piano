# Seed configuration: produces the kernel binary whose undefined symbols the
# corecrypto namespacing needs.
#
# scripts/build-corecrypto-14.py --namespace renames the provider symbols that
# collide with the kernel's undefined symbols, and reads that set from
# build/xnu/ios-obj/DEVELOPMENT_ARM64_BCM2837/mach.development.bcm2837.unstripped.noctf.
#
# The build script cannot produce that kernel with the crypto tree enabled: the
# archive-linking block is gated on XNU_SOURCE_CORECRYPTO14, and enabling it also
# makes the script require build/corecrypto-2023/libcorecrypto_kernel_noasm-namespaced.a,
# which is the very file this pass exists to create. So the seed pass switches the
# crypto tree off, and with it every board driver archive, leaving a plain XNU.
#
# This is not a device configuration. Do not ship a kernel built from it.

CONFIG_XNU_SOURCE_CORECRYPTO14=n
CONFIG_XNU_SOURCE_PTHREAD=n
CONFIG_XNU_ARM_DT_PLATFORM=n
CONFIG_XNU_ARMCPU=n
CONFIG_XNU_NATIVE_UFS=n
CONFIG_XNU_NATIVE_AES=n
CONFIG_XNU_NATIVE_RAM_BLOCK=n
CONFIG_XNU_TRUST_CACHE_RUNTIME=n
CONFIG_XNU_SOURCE_MOCKFS=n
CONFIG_XNU_NATIVE_CS_HASH_CACHE=n
CONFIG_XNU_DT_PANIC_REGION=n
CONFIG_XNU_ZONE_PGZ_ALIGNMENT_PROBE=n
CONFIG_XNU_NATIVE_ARCH_TIMER=n
CONFIG_XNU_NATIVE_PAN=n
CONFIG_XNU_NATIVE_LEGACY_DISPLAY=n
CONFIG_XNU_BOOT_PROGRESS=n
CONFIG_XNU_VERIFIED_ROOT_PROBE=n
CONFIG_XNU_OWNER_ROOT_AUDIT=n
CONFIG_XNU_OWNER_ROOT_TRUST=n
CONFIG_XNU_OWNER_CACHE_MOUNT=n
CONFIG_XNU_OWNER_CACHE_STARTUP=n
CONFIG_XNU_OWNER_BOOT_MANIFEST=n
CONFIG_XNU_OWNER_DATA_MOUNT=n
CONFIG_XNU_OWNER_UNION_SYSTEMOS=n
CONFIG_XNU_NATIVE_VIRTIO_BLOCK=n
CONFIG_XNU_NATIVE_VIRTIO_CONSOLE=n
CONFIG_XNU_SHENG_PMGR=n
CONFIG_XNU_NATIVE_MOBILE_DISPLAY=n
CONFIG_XNU_NATIVE_ADRENO=n
CONFIG_XNU_ARMVIRT_PLATFORM=n

CONFIG_XNU_CRYPTO_BOOTSTRAP="source"
CONFIG_XNU_EXTRA_LD_ARCHIVES=""
CONFIG_XNU_OWNER_DATA_VOLUME_UUID="00000000-0000-0000-0000-000000000000"
